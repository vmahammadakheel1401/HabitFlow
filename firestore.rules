rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collection Rules ---

    /**
     * User Profiles Collection
     * Matches user's request for users/{userId} logic (mapped to /profiles/{uid} here)
     */
    match /profiles/{uid} {
      // Allow users to read their own profile
      allow get: if isOwner(uid);
      
      // Allow creation and updates of their own profile
      allow create, update: if isOwner(uid) && 
        incoming().uid == uid &&
        incoming().email is string &&
        incoming().displayName is string;
    }

    /**
     * Habits Collection
     */
    match /habits/{habitId} {
      // Security Pillar #8: Explicitly check ownership on list/read
      allow read, list: if isSignedIn() && existing().userId == request.auth.uid;
      
      // Security Pillar #2: Validate creation
      allow create: if isSignedIn() && 
        incoming().userId == request.auth.uid &&
        incoming().name is string;
        
      // Security Pillar #4: Tiered updates
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    /**
     * Logs Collection
     */
    match /logs/{logId} {
      allow read, list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    /**
     * Categories Collection
     */
    match /categories/{categoryId} {
      allow read, list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
