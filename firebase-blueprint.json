{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account and profile settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "hiddenCategoryIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A habit tracked by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "timeOfDay": { "type": "string", "enum": ["Morning", "Afternoon", "Evening"] },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "frequency": { "type": "string" },
        "type": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "userId", "createdAt"]
    },
    "HabitLog": {
      "title": "Habit Log",
      "description": "Daily completion record for a habit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "habitId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["completed", "skipped", "none"] },
        "userId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["habitId", "date", "status", "userId"]
    },
    "Category": {
      "title": "Category",
      "description": "Habit category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "userId": { "type": "string" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["name", "color", "isCustom"]
    }
  },
  "firestore": {
    "/profiles/{uid}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/habits/{habitId}": {
      "schema": "Habit",
      "description": "User habits"
    },
    "/logs/{logId}": {
      "schema": "HabitLog",
      "description": "Completion logs"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Habit categories"
    }
  }
}
